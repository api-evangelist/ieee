{
  "item": [
    {
      "id": "fd9afacf-58b9-4270-9dbe-6dbb46094845",
      "name": "Metadata Search",
      "description": {
        "content": "Query and retrieve metadata records and abstracts for IEEE documents",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "b38565c6-f14b-44eb-b4fb-ed249dcf983f",
          "name": "Search IEEE Xplore article metadata",
          "request": {
            "name": "Search IEEE Xplore article metadata",
            "description": {
              "content": "Query and retrieve metadata records and abstracts for more than 6 million documents in IEEE Xplore including journals, conference proceedings, standards, books, and courses. Supports free-text, Boolean, and fielded searches. Returns up to 200 records per request with JSON (default) or XML output. The apikey query parameter is required on every request.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search",
                "articles"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "apikey",
                  "value": "<string>",
                  "description": "(Required) API key issued by the IEEE Developer Portal. Required on every request."
                },
                {
                  "disabled": false,
                  "key": "querytext",
                  "value": "<string>",
                  "description": "Free-text search across all configured metadata fields and abstract text. Use for general keyword searches."
                },
                {
                  "disabled": false,
                  "key": "abstract",
                  "value": "<string>",
                  "description": "Search text within the abstract field only."
                },
                {
                  "disabled": false,
                  "key": "affiliation",
                  "value": "<string>",
                  "description": "Search by author institutional affiliation text."
                },
                {
                  "disabled": false,
                  "key": "article_number",
                  "value": "<string>",
                  "description": "IEEE unique identifier for a specific article. Use to retrieve a single known document."
                },
                {
                  "disabled": false,
                  "key": "article_title",
                  "value": "<string>",
                  "description": "Search within the article title field."
                },
                {
                  "disabled": false,
                  "key": "author",
                  "value": "<string>",
                  "description": "Search by author name."
                },
                {
                  "disabled": false,
                  "key": "booleantext",
                  "value": "<string>",
                  "description": "Boolean query against all configured metadata fields, abstract, and document text. Supports AND, OR, NOT operators."
                },
                {
                  "disabled": false,
                  "key": "content_type",
                  "value": "<string>",
                  "description": "Filter results by content type."
                },
                {
                  "disabled": false,
                  "key": "d_au",
                  "value": "<string>",
                  "description": "Faceted author search using Open Author Facet data field."
                },
                {
                  "disabled": false,
                  "key": "d_pubtype",
                  "value": "<string>",
                  "description": "Faceted content-type filter using Open Content Type Facet data field."
                },
                {
                  "disabled": false,
                  "key": "d_year",
                  "value": "<integer>",
                  "description": "Faceted publication year filter."
                },
                {
                  "disabled": false,
                  "key": "doi",
                  "value": "<string>",
                  "description": "Search or retrieve a document by its Digital Object Identifier."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<string>",
                  "description": "Upper bound for publication date filter. Format: YYYYMMDD or YYYY."
                },
                {
                  "disabled": false,
                  "key": "index_terms",
                  "value": "<string>",
                  "description": "Search within author keywords, IEEE Terms, and MeSH Terms."
                },
                {
                  "disabled": false,
                  "key": "isbn",
                  "value": "<string>",
                  "description": "Search by International Standard Book Number."
                },
                {
                  "disabled": false,
                  "key": "issn",
                  "value": "<string>",
                  "description": "Search by International Standard Serial Number."
                },
                {
                  "disabled": false,
                  "key": "is_number",
                  "value": "<string>",
                  "description": "IEEE internal journal issue identifier."
                },
                {
                  "disabled": false,
                  "key": "max_records",
                  "value": "25",
                  "description": "Maximum number of records to return per request. Default is 25; maximum is 200."
                },
                {
                  "disabled": false,
                  "key": "publication_number",
                  "value": "<string>",
                  "description": "IEEE unique publication record number (journal or conference)."
                },
                {
                  "disabled": false,
                  "key": "publication_title",
                  "value": "<string>",
                  "description": "Search within the publication title (journal, conference, or book name)."
                },
                {
                  "disabled": false,
                  "key": "publication_year",
                  "value": "<integer>",
                  "description": "Filter results by publication year."
                },
                {
                  "disabled": false,
                  "key": "sort_field",
                  "value": "<string>",
                  "description": "Field to sort results by."
                },
                {
                  "disabled": false,
                  "key": "sort_order",
                  "value": "asc",
                  "description": "Sort direction."
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<string>",
                  "description": "Lower bound for publication date filter. Format: YYYYMMDD or YYYY."
                },
                {
                  "disabled": false,
                  "key": "start_record",
                  "value": "1",
                  "description": "Sequence number of the first record to return. Used for pagination. Default is 1."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format. Default is json."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
